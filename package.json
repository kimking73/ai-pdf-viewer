{
  "name": "ai-pdf-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "대학(원)생이 AI 튜터와 함께 PDF를 읽는 macOS 데스크톱 앱",
  "author": "AI PDF Viewer Team",
  "main": "./out/main/index.js",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "temml": "0.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "package:mac": "npm run build && electron-builder --mac --publish never --config electron-builder.config.mjs",
    "test:packaged": "node scripts/smoke-packaged.mjs"
  },
  "license": "MIT"
}
