{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsc-e2e",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["e2e/**/*", "src/renderer/src/env.d.ts", "src/shared/ipc/*.ts", "playwright.config.ts"],
  "exclude": ["src/shared/**/*.test.ts"]
}
